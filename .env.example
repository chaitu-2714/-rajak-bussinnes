# BizPilot AI - example environment file.
# Copy to .env (or set these variables in your shell) and adjust as needed.
# The application never requires a .env file: these are optional overrides.

# Folder that holds the SQLite database, logs, backups and exports.
# Default: %LOCALAPPDATA%\BizPilotAI  (Windows)
#          ~/.local/share/BizPilotAI (Linux)
#          ~/Library/Application Support/BizPilotAI (macOS)
BIZPILOT_DATA_DIR=

# Environment label: production | development | testing
BIZPILOT_ENV=production

# Optional overrides (normally resolved automatically, including in a frozen build)
BIZPILOT_RESOURCES_DIR=
BIZPILOT_MIGRATIONS_DIR=

# Secrets are never stored in this file. There is no default administrator
# password: the first Super Admin is created by the setup wizard on first launch.
